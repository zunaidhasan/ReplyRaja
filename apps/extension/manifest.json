{
  "manifest_version": 3,
  "name": "ReplyRaja for Meta Business Suite",
  "version": "1.0.0",
  "description": "Bengali-first AI Sales Assistant sidebar for Facebook Messenger and Instagram Direct in Meta Business Suite.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ReplyRaja Sales Assistant"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "http://localhost:4000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
